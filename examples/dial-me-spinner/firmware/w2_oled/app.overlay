/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * W2's additions to the board subset (Phase 2 milestone W-fw), transcribed from dial-me-spinner
 * docs/firmware.md section 3.1 (the board DTS draft) and section 1.3 (the pin table) at 6854d25:
 *   - board-signals: LED_PWR_EN (P1.04, U2's ON, R3 100 kOhm pull-down) and OLED_VCC_EN (P1.02,
 *     U21's ON, R25 100 kOhm pull-down: OLED_VIN -> TPS61040) as plain GPIO outputs, as in W1
 *     (the vled node deleted: P1.04 has one owner);
 *   - UARTE0, TX only on P1.00 at 1 Mbaud, as the console (the log, ADR-008 D8).
 * An application overlay, not the board file, so the E1-E3 images build exactly as before.
 */
/delete-node/ &vled;

/ {
	chosen {
		zephyr,console = &uart0;               /* TX-only log on P1.00 */
	};
};

&board_signals {
	led-pwr-en-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;    /* LED_PWR_EN -> U2 TPS22917 ON */
	oled-vcc-en-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;   /* OLED_VCC_EN -> U21 TPS22917 ON */
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
			low-power-enable;
		};
	};
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	disable-rx;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};
