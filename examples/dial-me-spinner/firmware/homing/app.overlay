/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * E3's additions to the board subset (ADR-008 D5, Amendment 9; Phase 1 plan M10), transcribed
 * from dial-me-spinner docs/firmware.md section 3.1 (the board DTS draft) at 6854d25:
 *   - detent-stepper: PWM0 (owned by the application through nrfx_pwm), nSLEEP on P1.15 (shared
 *     by U40 and U41), HOME_N on P1.14 (U42 DRV5032FA, push-pull, low = magnet present), the
 *     carriage geometry (15 um per full step, 500 steps of stroke) and the coil resistance;
 *   - &pwm0 disabled, so Zephyr's PWM driver does not bind (firmware.md: "PWM0 is owned by the
 *     detent stepper driver through nrfx_pwm"). The application gives nrfx the pins of
 *     firmware.md's pwm0_default group (P0.26, P0.05, P0.07, P0.11 = channels 0-3) itself;
 *   - vsys-sense and the SAADC's channel 0 (E2's, firmware.md section 12.4), for the amplitude's
 *     VSYS reading (section 5.3, MD-3);
 *   - UARTE0, TX only on P1.00 at 1 Mbaud, as the console (the log, ADR-008 D8).
 */
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	chosen {
		zephyr,console = &uart0;               /* TX-only log on P1.00 */
	};

	detent: detent-stepper {
		compatible = "dial,detent-stepper";
		pwm = <&pwm0>;
		nsleep-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		home-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
		carriage-um-per-step = <15>;           /* M2x0.4 lead, 20 steps/rev: 0.02 mm slider x 0.75 slot */
		microsteps = <8>;
		stroke-steps = <500>;                  /* 7.5 mm / 0.015 mm, click -> park (mechanical.md 7) */
		coil-milliohms = <20000>;
	};

	vsys_sense: vsys-sense {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <1000000>;      /* 2.2 MOhm / 1 MOhm, SPEC section 3 */
		full-ohms = <3200000>;
	};
};

&pwm0 {
	status = "disabled";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";            /* 0.6 V ref -> 3.6 V full scale */
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 VSYS_SENSE */
		zephyr,resolution = <12>;
		zephyr,oversampling = <3>;               /* 8x */
	};
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
			low-power-enable;
		};
	};
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	disable-rx;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};
