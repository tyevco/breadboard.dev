/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * E2's additions to the board subset (ADR-008 D5, Phase 1 plan M8), transcribed from
 * dial-me-spinner docs/firmware.md section 3.1 (the board DTS draft) at 6854d25:
 *   - vsys-sense: the VSYS divider on AIN0 (R1 2.2 MOhm over R2 1 MOhm, C5 100 nF);
 *   - the SAADC's channel 0: gain 1/6, internal 0.6 V reference, TACQ 40 us, AIN0, 12 bits, 8x;
 *   - UARTE0, TX only on P1.00 at 1 Mbaud, as the console (the log, ADR-008 D8).
 * An application overlay, not the board file, so led_rail.elf and led_rail_wrong_order.elf
 * (E1) build exactly as before.
 */
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	chosen {
		zephyr,console = &uart0;               /* TX-only log on P1.00 */
	};

	vsys_sense: vsys-sense {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <1000000>;      /* 2.2 MOhm / 1 MOhm, SPEC section 3 */
		full-ohms = <3200000>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";            /* 0.6 V ref -> 3.6 V full scale */
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 VSYS_SENSE */
		zephyr,resolution = <12>;
		zephyr,oversampling = <3>;               /* 8x */
	};
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 0)>;
			low-power-enable;
		};
	};
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	disable-rx;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};
