		(uuid "9d615add-8f0b-536e-a17c-5b1faf16444f")
	)
	(text "Same circuit as examples/adc/board.cir. PA4 drives R1 into the RC-filtered divider (R2, C1) on\nADC_IN, which PA1 reads (adc_in). PA5 drives the alarm LED D1 through R3. PA6 and PA7 are not\nconnected. No decoupling: board.cir has none, and this drawing must give the same analog deck."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "48a2c5de-0960-5dab-9005-cf5fc47ed678")
	)
