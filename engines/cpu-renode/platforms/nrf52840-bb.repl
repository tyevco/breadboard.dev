// Breadboard's nRF52840, platform nrf52840-bb@1 (ADR-008 D1): Renode
// 1.17.0's stock platforms/cpus/nrf52840.repl with
//   - the network-dependent init removed. The stock file's sysbus init block
//     starts with
//         ApplySVD @https://dl.antmicro.com/projects/renode/svd/NRF52840.svd.gz
//     which downloads the SVD on every load and makes unimplemented
//     registers read the SVD reset value instead of 0. A run must depend on
//     neither, so this file replaces the block and keeps the stock Tags
//     (FICR, DEVICEADDRTYPE, DEVICEADDR[0], PSELRESET) unchanged;
//   - the CPU at the part's clock, 64 MIPS (Renode's default is 100).
//     Instruction-count timing is then right for code that averages about
//     one instruction per cycle; nrfx busy-waits run at about 2/3 of their
//     requested time (ADR-008 Context 2, the nrf-busywait gate).
// No peripheral is replaced (Phase 1 M2), so this file names no Breadboard
// plugin type. The lookahead block is mapped at 0x5FFF0000 by the engine on
// boards that load it.
using "platforms/cpus/nrf52840.repl"

cpu:
    PerformanceInMips: 64

sysbus:
    init:
        Tag <0x10000000, 0x10000FFF> "FICR"
        Tag <0x100000a0, 0x100000a3> "DEVICEADDRTYPE" 0x1 # random address
        Tag <0x100000a4, 0x100000a7> "DEVICEADDR[0]" 0xAABBCCDD
        Tag <0x10001200, 0x10001203> "PSELRESET"
