{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/project.schema.json",
  "title": "bb-project/0: bb.toml, a Breadboard project (spec/project.md, ADR-007 D5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "board"],
  "properties": {
    "schema": { "const": "bb-project/0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "simulate": { "$ref": "#/$defs/boardId" }
      }
    },
    "board": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/boardId" },
          "netlist": { "type": "string", "minLength": 1 },
          "kicad": { "type": "string", "pattern": "\\.kicad_pro$" },
          "ground": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["netlist"], "not": { "required": ["kicad"] } },
          { "required": ["kicad"], "not": { "required": ["netlist"] } }
        ]
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "paths": { "type": "array", "items": { "type": "string" } } }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fields": { "type": "array", "items": { "type": "string" } } }
    },
    "instances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string", "pattern": "^(none|[a-z0-9._-]+/[a-z0-9._-]+(@[0-9]+\\.[0-9]+\\.[0-9]+)?)$" },
          "reason": { "type": "string" },
          "analog": { "type": "string" }
        },
        "if": { "properties": { "package": { "const": "none" } }, "required": ["package"] },
        "then": { "required": ["reason"] }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "kind", "hash"],
              "properties": {
                "file": { "type": "string" },
                "kind": { "enum": ["elf", "bin", "hex", "uf2", "flash"] },
                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "offset": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "bind": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin", "model"],
        "properties": {
          "pin": { "type": "string", "pattern": "^([a-z0-9_-]+:)?[^.:]+\\..+$" },
          "model": { "enum": ["digital_out", "digital_in", "adc_in"] },
          "set": { "type": "string" },
          "net": { "type": "string" },
          "voh": { "type": "string" }, "vol": { "type": "string" },
          "rise": { "type": "string" }, "fall": { "type": "string" },
          "zout": { "type": "string" },
          "vih": { "type": "string" }, "vil": { "type": "string" },
          "cin": { "type": "string" },
          "vref": { "type": "string" }, "bits": { "type": "string" }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "nets": { "type": "array", "items": { "type": "string" } } }
    },
    "connection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "model": { "type": "string" },
          "pins": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    }
  },
  "$defs": {
    "boardId": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
  }
}
