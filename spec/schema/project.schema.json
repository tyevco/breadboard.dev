{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/project.schema.json",
  "title": "bb-project/1: bb.toml, a Breadboard project (spec/project.md, ADR-007 D5, ADR-011 D4, ADR-013 D1-D3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "board"],
  "properties": {
    "schema": { "const": "bb-project/1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "simulate": {
          "description": "A board id, or (bb-project/1, ADR-013 D2) a list of them; a list of several boards is milestone R2's system run.",
          "oneOf": [{ "$ref": "#/$defs/boardId" }, { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/boardId" } }]
        }
      }
    },
    "board": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/boardId" },
          "netlist": { "type": "string", "minLength": 1 },
          "kicad": { "type": "string", "pattern": "\\.kicad_pro$" },
          "ground": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["netlist"], "not": { "required": ["kicad"] } },
          { "required": ["kicad"], "not": { "required": ["netlist"] } }
        ]
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "paths": { "type": "array", "items": { "type": "string" } } }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fields": { "type": "array", "items": { "type": "string" } } }
    },
    "instances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string", "pattern": "^(none|[a-z0-9._-]+/[a-z0-9._-]+(@[0-9]+\\.[0-9]+\\.[0-9]+)?)$" },
          "reason": { "type": "string" },
          "analog": { "type": "string" }
        },
        "if": { "properties": { "package": { "const": "none" } }, "required": ["package"] },
        "then": { "required": ["reason"] }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "kind", "hash"],
              "properties": {
                "file": { "type": "string" },
                "kind": { "enum": ["elf", "bin", "hex", "uf2", "flash"] },
                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "offset": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "bind": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin", "model"],
        "properties": {
          "pin": { "type": "string", "pattern": "^([a-z0-9_-]+:)?[^.:]+\\..+$" },
          "model": { "enum": ["digital_out", "digital_in", "adc_in"] },
          "set": { "type": "string" },
          "net": { "type": "string" },
          "voh": { "type": "string" }, "vol": { "type": "string" },
          "rise": { "type": "string" }, "fall": { "type": "string" },
          "zout": { "type": "string" },
          "vih": { "type": "string" }, "vil": { "type": "string" },
          "cin": { "type": "string" },
          "vref": { "type": "string" }, "bits": { "type": "string" },
          "load": { "type": "string" },
          "rail": { "type": "string" }, "rhiz": { "type": "string" },
          "trace_samples": { "type": "boolean" }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "nets": { "type": "array", "items": { "type": "string" } } }
    },
    "device": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "package", "bind"],
        "properties": {
          "ref": { "type": "string", "pattern": "^([a-z0-9_-]+:)?[^.:]+$" },
          "package": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+(@[0-9]+\\.[0-9]+\\.[0-9]+)?$" },
          "params": { "type": "object", "additionalProperties": { "type": "string" } },
          "virtual": { "type": "boolean" },
          "bind": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pin", "net", "model"],
              "properties": {
                "pin": { "type": "string", "minLength": 1 },
                "net": { "type": "string", "minLength": 1 },
                "model": { "enum": ["digital_out", "digital_in"] },
                "set": { "type": "string" },
                "voh": { "type": "string" }, "vol": { "type": "string" },
                "rise": { "type": "string" }, "fall": { "type": "string" },
                "zout": { "type": "string" },
                "vih": { "type": "string" }, "vil": { "type": "string" },
                "cin": { "type": "string" },
                "rail": { "type": "string" }, "rhiz": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "connection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "model": { "type": "string" },
          "pins": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "run": {
      "description": "bb-project/1 (ADR-013 D3): runs without a CPU target (cpu = \"none\") and the engine-neutral lattice; milestone R3, refused by bb until it is implemented.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "const": "none" },
        "lattice": { "type": "string", "minLength": 1 }
      }
    },
    "registries": {
      "description": "bb-project/1 (ADR-011 D4): private registries, routed by namespace; read and checked, inert until milestone E1.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "key", "namespaces"],
        "properties": {
          "url": { "type": "string", "pattern": "^(https|file)://" },
          "key": { "type": "string", "minLength": 1 },
          "namespaces": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9._-]+$" } }
        }
      }
    }
  },
  "$defs": {
    "boardId": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
  }
}
