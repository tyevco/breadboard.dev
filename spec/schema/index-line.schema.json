{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/index-line.schema.json",
  "title": "One line of a registry index file, index/<ns>/<name>.jsonl (spec/registry.md section 2, ADR-011 D1)",
  "description": "Canonical JSON (spec/canonical-json.md), one line per published version, append-only: a line never changes except yanked, and removed on a legal removal (D2). The registry's CI writes every line; provenance.reviewed_by and provenance.unverified_claims are CI's (ADR-012), never a package file's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vers", "tree", "size", "license", "schema", "deps", "provenance", "platforms", "yanked", "pubtime"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
    "vers": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "tree": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 0, "maximum": 2000000 },
    "license": { "type": "string", "minLength": 1 },
    "schema": { "type": "string", "pattern": "^bb-part/(0|[1-9][0-9]*)$" },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "req"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
          "req": { "type": "string", "pattern": "^(\\^?(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){0,2}|=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence", "reviewed_by", "generated_by", "unverified_claims"],
      "properties": {
        "source": { "enum": [null, "datasheet", "vendor_model", "vendor_derived", "measured", "estimated", "agent_generated"] },
        "confidence": { "enum": [null, "unchecked", "self_checked", "datasheet_checked", "measured"] },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["login", "review"],
            "properties": { "login": { "type": "string" }, "review": { "type": "integer" } }
          }
        },
        "generated_by": { "type": ["string", "null"] },
        "unverified_claims": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "yanked": { "type": "boolean" },
    "pubtime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "removed": { "type": "string", "minLength": 1 }
  }
}
