{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/pins.schema.json",
  "title": "bb-pins/0 and bb-pins/1: a component package's pins.toml (spec/package.md, ADR-006 D4, ADR-009 D3, D5)",
  "description": "bb-pins/1 (the Phase 2 schema epoch, milestone S) keeps every bb-pins/0 key and its meaning and adds limits (ADR-009 D3) and the digital_out parameters rail and rhiz (ADR-009 D5), accepted and inert until milestones P1 and P2 use them. The pin model name power is reserved (ADR-009 D3). A bb-pins/0 file has none of the bb-pins/1 keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pin"],
  "properties": {
    "schema": { "enum": ["bb-pins/0", "bb-pins/1"] },
    "pin": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "role"],
        "properties": {
          "number": { "type": "string", "minLength": 1, "description": "The footprint or chip pin number as KiCad reports it." },
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["power_in", "power_out", "ground", "io", "input", "output", "analog", "nc", "passive"] },
          "supply": { "type": "string" },
          "alt": { "type": "array", "items": { "type": "string" } },
          "models": { "type": "array", "uniqueItems": true, "items": { "enum": ["digital_out", "digital_in", "adc_in"] } },
          "adc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel"],
            "properties": { "channel": { "type": "string" } }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digital_out": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digital_out" } },
        "digital_in": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digital_in" } },
        "adc_in": { "type": "object", "additionalProperties": { "$ref": "#/$defs/adc_in" } }
      }
    },
    "limits": {
      "description": "bb-pins/1 (ADR-009 D3): relational limits for absolute maximum ratings; a bound is <value>, <pin> + <value> or <pin> - <value>.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin", "source"],
        "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
        "properties": {
          "pin": { "type": "string", "minLength": 1 },
          "min": { "$ref": "#/$defs/bound" },
          "max": { "$ref": "#/$defs/bound" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A bb-pins/0 file has none of the bb-pins/1 keys.",
      "if": { "properties": { "schema": { "const": "bb-pins/0" } } },
      "then": {
        "not": { "required": ["limits"] },
        "properties": {
          "defaults": {
            "properties": {
              "digital_out": { "additionalProperties": { "not": { "anyOf": [{ "required": ["rail"] }, { "required": ["rhiz"] }] } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "value": {
      "description": "A number with an optional SI prefix and unit (spec/package.md, Values), or for a voltage a supply pin name optionally scaled (VDD, 0.7*VDD).",
      "type": "string",
      "minLength": 1
    },
    "bound": {
      "description": "<value>, <pin> + <value> or <pin> - <value> (one supply-plus-offset term, no general expressions; ADR-009 D3).",
      "type": "string",
      "pattern": "^([+-]?[0-9.]\\S*|[A-Za-z][A-Za-z0-9_.+-]*( [+-] [+-]?[0-9.]\\S*)?)$"
    },
    "digital_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voh", "vol", "rise", "fall", "zout"],
      "properties": {
        "voh": { "$ref": "#/$defs/value" },
        "vol": { "$ref": "#/$defs/value" },
        "rise": { "$ref": "#/$defs/value" },
        "fall": { "$ref": "#/$defs/value" },
        "zout": { "$ref": "#/$defs/value" },
        "rail": { "type": "string", "minLength": 1, "description": "bb-pins/1 (ADR-009 D5): the supply pin a pi output drives from (default [power] io_rail)." },
        "rhiz": { "$ref": "#/$defs/value", "description": "bb-pins/1 (ADR-009 D5): the high-Z leakage resistance (default 100Meg)." }
      }
    },
    "digital_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vih", "vil", "cin"],
      "properties": {
        "vih": { "$ref": "#/$defs/value" },
        "vil": { "$ref": "#/$defs/value" },
        "cin": { "$ref": "#/$defs/value" }
      }
    },
    "adc_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vref", "bits"],
      "properties": {
        "vref": { "$ref": "#/$defs/value" },
        "bits": { "$ref": "#/$defs/value" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "load": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" }
      }
    }
  }
}
