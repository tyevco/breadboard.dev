{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/test.schema.json",
  "title": "bb-test/0: a bb test file (spec/test.md section 1; ADR-010 D8, Amendment 5)",
  "description": "The JSON form of a bb test file (TOML converted to JSON as is). Every path is relative to the test file. A case is one bb run of a project (project) or a board file (board), the file's unless the case names its own; [defaults] gives every case's run options that the case does not. bb checks what this schema cannot: the times and values, the names asserts and expect give, same_as, a board file's single target and its probes, and gate G9 (a negative control needs a count or event assertion expected to pass). An inline [[case.assert]] table is spec/project.md section 3.4's [[assert]], checked by bb.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case"],
  "not": { "required": ["project", "board"] },
  "properties": {
    "schema": { "const": "bb-test/0" },
    "project": { "type": "string", "minLength": 1 },
    "board": { "type": "string", "minLength": 1 },
    "defaults": { "type": "object", "allOf": [{ "$ref": "#/$defs/opts" }], "unevaluatedProperties": false },
    "case": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "not": { "required": ["project", "board"] },
        "allOf": [{ "$ref": "#/$defs/opts" }],
        "unevaluatedProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "not": { "pattern": "-ref$" } },
          "project": { "type": "string", "minLength": 1 },
          "board": { "type": "string", "minLength": 1 },
          "asserts": { "type": "array", "items": { "type": "string" } },
          "expect": {
            "type": "object",
            "additionalProperties": { "enum": ["pass", "fail", "not_evaluable"] }
          },
          "reference": { "type": "boolean" },
          "golden": { "type": "string", "minLength": 1 },
          "same_as": { "type": "string", "minLength": 1 },
          "assert": {
            "type": "array",
            "items": { "type": "object", "required": ["name", "kind"] }
          }
        }
      }
    }
  },
  "$defs": {
    "opts": {
      "type": "object",
      "properties": {
        "for": { "type": "string" },
        "fidelity": { "enum": ["fast", "pi"] },
        "bench": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "probes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sample_rate": { "type": "string" },
        "assert_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "max_quantum": { "type": "string" },
        "renode_quantum": { "type": "string" },
        "engine_order": { "enum": ["mcu-first", "analog-first"] },
        "lookahead": { "enum": ["on", "off"] },
        "adc_push": { "enum": ["change", "every"] },
        "seed": { "type": "integer" },
        "allow_unqualified": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
