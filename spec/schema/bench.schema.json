{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/bench.schema.json",
  "title": "bb-bench/0 and bb-bench/1: a bench (spec/project.md section 3; ADR-007 D5, ADR-010 D1-D3)",
  "description": "The JSON form of a bench file (TOML converted to JSON as is). bb-bench/1 keeps every bb-bench/0 key and its meaning (ADR-010 D1) and adds seed, [[action]], [[playback]], [[fault]] and a [[load]] profile (milestone B1), and fidelity, corner, [corners] and [[battery]] (milestone P1; ADR-009 D1, D8, Amendment 4), and [[activity]] and a [[load]] replace (milestone P3; ADR-009 D4, Amendment 6). The other bb-bench/1 keys of ADR-010 D2 ([[env]], [probes]) are described loosely here and refused by bb until their milestone implements them. A bb-bench/0 file has none of the bb-bench/1 keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "enum": ["bb-bench/0", "bb-bench/1"] },
    "temp_c": { "type": "string" },
    "supply": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["net", "volts"],
        "properties": {
          "net": { "type": "string" },
          "volts": { "type": "string" },
          "rs": { "type": "string" },
          "track": {
            "type": "object",
            "additionalProperties": false,
            "required": ["net", "drop"],
            "properties": { "net": { "type": "string" }, "drop": { "type": "string" } }
          }
        }
      }
    },
    "load": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["net"],
        "properties": {
          "net": { "type": "string" },
          "amps": { "type": "string" },
          "profile": { "type": "string", "description": "bb-bench/1: a CSV t,amps (ADR-010 D2, D3)" },
          "interp": { "$ref": "#/$defs/interp" },
          "replace": { "type": "string", "description": "bb-bench/1: static-load mode (ADR-009 D4, milestone P3): the instance whose supply_load this load stands in for" }
        },
        "oneOf": [
          { "required": ["amps"], "not": { "anyOf": [{ "required": ["profile"] }, { "required": ["interp"] }] } },
          { "required": ["profile"], "not": { "required": ["amps"] } }
        ]
      }
    },
    "nominal": { "type": "object", "additionalProperties": { "type": "string" } },
    "pwl": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["net", "points"],
        "properties": {
          "net": { "type": "string" },
          "rs": { "type": "string" },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "analog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nets": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": { "set": { "type": "string" } }
    },
    "seed": { "type": "integer", "minimum": 0, "description": "bb-bench/1: the seed of the declared random elements (contact bounce); 1 when not given" },
    "action": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "press": { "type": "string", "description": "an instance with a switch view" },
          "set": { "type": "string", "description": "a [[supply]]'s net, or a bound MCU digital_in pin" },
          "to": { "type": "string" },
          "at": { "type": "string" },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": ["edge", "level"],
            "properties": {
              "edge": { "type": "string", "description": "an MCU pin bound as digital_out" },
              "level": { "enum": [0, 1] },
              "delay": { "type": "string" }
            }
          },
          "for": { "type": "string" },
          "bounce": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count"],
            "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 64 }, "max": { "type": "string" } }
          }
        },
        "allOf": [
          { "oneOf": [{ "required": ["press"], "not": { "anyOf": [{ "required": ["set"] }, { "required": ["to"] }] } },
                      { "required": ["set", "to"], "not": { "anyOf": [{ "required": ["press"] }, { "required": ["bounce"] }] } }] },
          { "oneOf": [{ "required": ["at"], "not": { "required": ["after"] } }, { "required": ["after"], "not": { "required": ["at"] } }] }
        ]
      }
    },
    "playback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["net", "file"],
        "properties": {
          "net": { "type": "string", "description": "an analog net, or a bound MCU digital_in pin (a digital stream)" },
          "file": { "type": "string", "description": "a canonical CSV t,<name> (ADR-010 D3), relative to the bench" },
          "rs": { "type": "string" },
          "interp": { "$ref": "#/$defs/interp" }
        }
      }
    },
    "fault": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "net", "at"],
        "properties": {
          "kind": { "enum": ["open", "short"] },
          "net": { "type": "string" },
          "pin": { "type": "string", "description": "open: the instance pin that leaves the net (main:C8.1)" },
          "at": { "type": "string" },
          "for": { "type": "string" }
        },
        "if": { "properties": { "kind": { "const": "open" } } },
        "then": { "required": ["pin"] },
        "else": { "not": { "required": ["pin"] } }
      }
    },
    "assert": {
      "type": "array",
      "description": "bb-bench/1, ADR-010 D5-D7 (milestone B2): the closed set of assertion kinds (spec/project.md section 3.4); in a bench, or in an assertion file (schema and [[assert]] only, bb run --assert)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "kind": { "enum": ["range", "at", "settle", "edge_timing", "count", "frequency", "log", "event"] },
          "msg": { "type": "string" },
          "requires": { "enum": ["fast", "pi", "si", "em"] },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "after": { "$ref": "#/$defs/assert_event" },
          "until": { "$ref": "#/$defs/assert_event" },
          "while": { "$ref": "#/$defs/level_of" },
          "net": { "type": "string" },
          "ref": { "type": "string" },
          "min": { "$ref": "#/$defs/assert_limit" },
          "max": { "$ref": "#/$defs/assert_limit" },
          "at": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/edge_of" }] },
          "event": { "oneOf": [{ "enum": ["reset", "warn", "error"] }, { "$ref": "#/$defs/edge_of" }] },
          "within": { "type": "string" },
          "start": { "$ref": "#/$defs/assert_event" },
          "end": { "$ref": "#/$defs/assert_event" },
          "pair": { "enum": ["last", "first"] },
          "level": { "enum": [0, 1] },
          "period": { "type": "string" },
          "tol": { "type": "string" },
          "match": { "type": "string" },
          "source": { "type": "string" },
          "field": { "type": "string" },
          "present": { "type": "boolean" }
        }
      }
    },
    "fidelity": { "enum": ["fast", "pi"], "description": "bb-bench/1, ADR-009 D1 (milestone P1): the run's rung; bb run --fidelity wins. si and em are Phase 3's" },
    "corner": { "$ref": "#/$defs/corner", "description": "bb-bench/1, ADR-009 D8 (milestone P1): every instance whose view declares this corner runs at it" },
    "corners": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/corner" },
      "description": "bb-bench/1, ADR-009 D8 (milestone P1; ADR-009 Amendment 4): per-instance corners, \"<board>:<ref>\" (or <ref>) = corner, over corner; the instance's view must declare it"
    },
    "battery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["net", "ocv", "soc", "r0"],
        "properties": {
          "net": { "type": "string" },
          "ocv": { "type": "string", "description": "a CSV soc,volts (soc in 0..1, increasing), relative to the bench" },
          "soc": { "type": "string", "description": "the state of charge, 0..1, for the whole run" },
          "r0": { "type": "string", "description": "the series resistance (> 0)" },
          "rc": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }, "description": "RC pairs [R, C], in series after R0" },
          "temp_c": { "type": "string", "description": "informative: the temperature the OCV table is for" }
        }
      },
      "description": "bb-bench/1, ADR-010 D2 (milestone P1; ADR-009 Amendment 4): a cell as the Norton current OCV(soc)/R0 behind R0, then the RC pairs"
    },
    "activity": {
      "type": "array",
      "description": "bb-bench/1, ADR-009 D4 (milestone P3): a bench-scheduled internal state of an instance's supply_load view",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "for"],
        "properties": {
          "state": { "type": "string", "pattern": "^[^#]+#[a-z0-9_]+$" },
          "at": { "type": "string" },
          "every": { "type": "string" },
          "for": { "type": "string" }
        }
      }
    },
    "env": { "type": "array", "items": { "type": "object" }, "description": "bb-bench/1, ADR-010 D2 (a later milestone; refused until then)" },
    "probes": { "type": "object", "description": "bb-bench/1, ADR-010 D2 per-probe rates (a later milestone; refused until then)" }
  },
  "if": { "properties": { "schema": { "const": "bb-bench/0" } } },
  "then": {
    "not": {
      "anyOf": [
        { "required": ["seed"] }, { "required": ["action"] }, { "required": ["playback"] }, { "required": ["fault"] },
        { "required": ["fidelity"] }, { "required": ["corner"] }, { "required": ["corners"] }, { "required": ["battery"] }, { "required": ["activity"] },
        { "required": ["env"] }, { "required": ["probes"] }, { "required": ["assert"] },
        { "required": ["load"], "properties": { "load": { "contains": { "anyOf": [{ "not": { "required": ["amps"] } }, { "required": ["replace"] }] } } } }
      ]
    }
  },
  "$defs": {
    "corner": { "type": "string", "pattern": "^(typ|min|max|suite_compat|worst_[a-z0-9_]+)$" },
    "interp": { "enum": ["linear", "hold"] },
    "edge_of": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "level"],
      "properties": { "edge": { "type": "string" }, "level": { "enum": [0, 1] } }
    },
    "level_of": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "level"],
      "properties": { "net": { "type": "string" }, "level": { "enum": [0, 1] } }
    },
    "assert_limit": {
      "description": "a quantity in the value grammar (volts or seconds), or an integer (a count or a level)",
      "type": ["string", "integer"]
    },
    "assert_event": {
      "description": "an edge { edge, level }, a log record { log, source }, or (edge_timing's start and end) an analog crossing { cross, ref, below | above }; delay only in after",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": { "type": "string" },
        "level": { "enum": [0, 1] },
        "log": { "type": "string" },
        "source": { "type": "string" },
        "delay": { "type": "string" },
        "cross": { "type": "string" },
        "ref": { "type": "string" },
        "below": { "type": "string" },
        "above": { "type": "string" }
      },
      "oneOf": [
        { "required": ["edge", "level"], "not": { "anyOf": [{ "required": ["log"] }, { "required": ["cross"] }] } },
        { "required": ["log"], "not": { "anyOf": [{ "required": ["edge"] }, { "required": ["cross"] }] } },
        { "required": ["cross"], "not": { "anyOf": [{ "required": ["edge"] }, { "required": ["log"] }] } }
      ]
    }
  }
}
