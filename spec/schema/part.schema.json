{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/spec/schema/part.schema.json",
  "title": "bb-part/0 and bb-part/1: a component package's part.toml (spec/package.md, ADR-006 D2-D4, ADR-009, ADR-010 D2, ADR-012)",
  "description": "The JSON form of part.toml (TOML converted to JSON as is). Unknown keys are an error; the keys still reserved (layers, thermal, rtl; pins.ibis; behavioral.cpu) are not accepted; behavioral.svd is a bb-part/1 key since milestone E1 (ADR-011 Amendment 2). bb-part/1 (the Phase 2 schema epoch, milestone S) keeps every bb-part/0 key and its meaning and adds [power] (ADR-009 D4, D5), a view's rails and [[analog.corners]] (ADR-009, D8), the switch (ADR-010 D2) and supply_load (ADR-009 D4) view kinds, [[document]], [claims] and a provenance's upstream_license (ADR-012 D3, D4; ADR-011 D7). The new keys are accepted and inert until their milestones use them; a bb-part/0 file has none of them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "part", "pins"],
  "properties": {
    "schema": { "enum": ["bb-part/0", "bb-part/1"] },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "kind": {
          "enum": ["soc", "module", "power", "analog_ic", "logic", "discrete", "passive", "connector", "mechanical", "testpoint"]
        },
        "manufacturer": { "type": "string" },
        "mpn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mpn_patterns": {
          "description": "Regular expressions matched against the whole normalised MPN (anchored implicitly; no ^ or $).",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "not": { "pattern": "^\\^|\\$$" } }
        },
        "lcsc": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "datasheet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string" }, "rev": { "type": "string" } }
        },
        "license": { "type": "string", "minLength": 1, "description": "An SPDX expression; LicenseRef-local-only forbids committing the package to a shared repository (ADR-006 D9)." },
        "description": { "type": "string" }
      }
    },
    "footprints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kicad": { "type": "array", "items": { "type": "string" } },
        "pinmap": { "type": "string" }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": { "file": { "type": "string" } }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chip", "pinmap"],
      "properties": {
        "chip": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
        "pinmap": { "type": "string" }
      }
    },
    "behavioral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": { "enum": ["renode", "device"] },
        "platform": { "$ref": "#/$defs/engine_id" },
        "device": { "$ref": "#/$defs/engine_id" },
        "svd": {
          "description": "bb-part/1 (ADR-011 D5, D7, Amendment 2): the vendor SVD, fetched at use by bb open and locked as a [[vendor_file]]; never part of the package.",
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "license"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "license": { "type": "string", "pattern": "^\\S+$" }
          }
        }
      },
      "oneOf": [
        { "properties": { "engine": { "const": "renode" } }, "required": ["platform"], "not": { "required": ["device"] } },
        { "properties": { "engine": { "const": "device" } }, "required": ["device"], "not": { "required": ["platform"] } }
      ]
    },
    "analog": { "type": "array", "items": { "$ref": "#/$defs/view" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": { "dir": { "type": "string" } }
    },
    "power": {
      "description": "bb-part/1 (ADR-009 D4, D5): supply currents per CPU state, the operating VDD minimum, and the rail digital_out drives from at pi.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idd": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["typ", "ref"],
            "properties": { "typ": { "$ref": "#/$defs/value" }, "max": { "$ref": "#/$defs/value" }, "ref": { "type": "string", "minLength": 1 } }
          }
        },
        "vdd_min": { "$ref": "#/$defs/value" },
        "io_rail": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "description": "bb-part/1 (ADR-012 D3): a hashed document the package's claims cite; the PDF itself is never committed.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "title": { "type": "string" },
          "revision": { "type": "string" },
          "url": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "fetched_by": { "type": "string", "pattern": "^(agent|user):.+$" }
        }
      }
    },
    "claims": {
      "description": "bb-part/1 (ADR-012 D4): the package's claims file (bb-claims/0, milestone E2; not read before then).",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": { "file": { "type": "string" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "part": { "properties": { "kind": { "const": "module" } } } } },
      "then": { "required": ["module"] },
      "else": { "not": { "required": ["module"] } }
    },
    {
      "description": "A bb-part/0 file has none of the bb-part/1 keys.",
      "if": { "properties": { "schema": { "const": "bb-part/0" } } },
      "then": {
        "not": { "anyOf": [{ "required": ["power"] }, { "required": ["document"] }, { "required": ["claims"] }] },
        "properties": {
          "analog": {
            "items": {
              "properties": { "kind": { "enum": ["circuit", "pin_load"] }, "provenance": { "not": { "required": ["upstream_license"] } } },
              "not": { "anyOf": [{ "required": ["rails"] }, { "required": ["corners"] }] }
            }
          },
          "provenance": { "not": { "required": ["upstream_license"] } }
        }
      }
    }
  ],
  "$defs": {
    "engine_id": { "type": "string", "pattern": "^[a-z0-9_./-]+@[0-9]+$" },
    "rung": { "enum": ["fast", "pi", "si", "em"] },
    "value": {
      "description": "A string in the value grammar of spec/package.md (a number with an optional SI prefix and unit; a bare M is a lint error).",
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence"],
      "properties": {
        "source": { "enum": ["datasheet", "vendor_model", "vendor_derived", "measured", "estimated", "agent_generated"] },
        "base": { "type": "string" },
        "refs": { "type": "array", "items": { "type": "string" } },
        "deviations": { "type": "array", "items": { "type": "string" } },
        "not_modelled": { "type": "array", "items": { "type": "string" } },
        "origin": { "type": "string" },
        "generated_by": { "type": "string" },
        "reviewed_by": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["unchecked", "self_checked", "datasheet_checked", "measured"] },
        "upstream_license": { "type": "string", "minLength": 1, "description": "bb-part/1 (ADR-011 D7): the upstream model's SPDX licence of a vendor_derived view." }
      }
    },
    "state_port": {
      "description": "bb-part/1 (ADR-009 D4): a supply_load view's port, a supply pin or a CPU state port #<state>.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["pin", "state"] },
        "pin": { "type": "string" },
        "state": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "oneOf": [
        { "properties": { "role": { "const": "pin" } }, "required": ["pin"], "not": { "required": ["state"] } },
        { "properties": { "role": { "const": "state" } }, "required": ["state"], "not": { "required": ["pin"] } }
      ]
    },
    "typed_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["pad", "ctrl", "observe", "pin"] },
        "signal": { "type": "string" },
        "pin": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "role": { "enum": ["ctrl", "observe"] } } }, "then": { "required": ["signal"], "not": { "required": ["pin"] } } },
        { "if": { "properties": { "role": { "const": "pin" } } }, "then": { "required": ["pin"], "not": { "required": ["signal"] } } },
        { "if": { "properties": { "role": { "const": "pad" } } }, "then": { "not": { "anyOf": [{ "required": ["pin"] }, { "required": ["signal"] }] } } }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fidelity", "ports"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "kind": { "enum": ["circuit", "pin_load", "switch", "supply_load"] },
        "purpose": { "type": "string" },
        "fidelity": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rung" } },
        "default_for": { "type": "array", "items": { "$ref": "#/$defs/rung" } },
        "file": { "type": "string" },
        "subckt": { "type": "string" },
        "ports": { "type": "array" },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "qualified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lattice", "options"],
            "properties": { "lattice": { "$ref": "#/$defs/value" }, "options": { "type": "string" } }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "rails": { "type": "array", "items": { "type": "string" }, "description": "bb-part/1 (ADR-009): the view's supply ports, informative, for lint." },
        "corners": {
          "description": "bb-part/1 (ADR-009 D8): named corners, parameter overrides with a reference.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ref"],
            "properties": {
              "name": { "type": "string", "pattern": "^(typ|min|max|suite_compat|worst_[a-z0-9_]+)$" },
              "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
              "ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "pin_load" } }, "required": ["kind"] },
          "then": { "required": ["file", "subckt"], "properties": { "ports": { "items": { "$ref": "#/$defs/typed_port" } } } }
        },
        {
          "description": "ADR-009 D4: a supply_load view has a file and a subckt, and typed pin and state ports.",
          "if": { "properties": { "kind": { "const": "supply_load" } }, "required": ["kind"] },
          "then": { "required": ["file", "subckt"], "properties": { "ports": { "items": { "$ref": "#/$defs/state_port" } } } }
        },
        {
          "description": "ADR-010 D2: a switch view's element is generated (no file or subckt); two contacts as typed pin ports; params ron, roff, bounce_max.",
          "if": { "properties": { "kind": { "const": "switch" } }, "required": ["kind"] },
          "then": {
            "not": { "anyOf": [{ "required": ["file"] }, { "required": ["subckt"] }] },
            "properties": {
              "ports": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "pin"],
                  "properties": { "role": { "const": "pin" }, "pin": { "type": "string" } }
                }
              },
              "params": { "propertyNames": { "enum": ["ron", "roff", "bounce_max"] } }
            }
          }
        },
        {
          "if": { "not": { "properties": { "kind": { "enum": ["pin_load", "switch", "supply_load"] } }, "required": ["kind"] } },
          "then": { "required": ["file", "subckt"], "properties": { "ports": { "items": { "type": "string" } } } }
        }
      ]
    }
  }
}
